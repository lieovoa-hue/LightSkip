<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/demo_delayed_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="96dp"
        android:text="模拟应用首页"
        android:textColor="@color/forest_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/demo_delayed_card"
        android:layout_width="300dp"
        android:layout_height="420dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_ad_card"
        android:elevation="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ad_creative"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="推广卡片"
                android:textColor="@color/on_forest"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="这个弹窗在 2 秒后才出现"
                android:textColor="@color/white_72"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/demo_popup_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_close_circle"
            android:clickable="true"
            android:contentDescription="关闭延迟广告"
            android:focusable="true"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />
    </FrameLayout>
</FrameLayout>
