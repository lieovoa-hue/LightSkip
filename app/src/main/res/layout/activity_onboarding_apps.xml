<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="10dp"
    android:paddingRight="20dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/apps_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_chevron_left"
            android:tint="@color/forest_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/apps_step"
            android:textColor="@color/muted"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/onboarding_select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="@string/select_all"
            android:textColor="@color/forest_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        style="@style/Text.H1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/apps_onboarding_title" />

    <TextView
        style="@style/Text.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/apps_onboarding_sub"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/onboarding_summary"
        style="@style/Text.Micro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/apps_summary_zero"
        android:textSize="10.5sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/onboarding_app_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/row_divider"
            android:dividerHeight="1dp"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/onboarding_app_empty"
            style="@style/Text.Micro"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/toast_no_launcher_apps"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/onboarding_done"
        style="@style/PrimaryButton"
        android:layout_marginTop="8dp"
        android:text="@string/apps_done" />

    <TextView
        style="@style/Text.Micro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/apps_after"
        android:textSize="9.5sp" />
</LinearLayout>