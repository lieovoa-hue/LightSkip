<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="14dp"
        android:paddingRight="20dp"
        android:paddingBottom="10dp">

        <TextView
            style="@style/Text.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version_short" />

        <TextView
            style="@style/Text.H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_title" />

        <LinearLayout
            android:id="@+id/settings_status_card"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_guard"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="14dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_status_shield"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_shield"
                android:tint="@color/lime" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/settings_status_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_status_ok"
                    android:textColor="@color/on_forest"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settings_status_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_status_sub_ok"
                    android:textColor="@color/white_68"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <com.lightskip.app.ui.ToggleView
                android:id="@+id/settings_toggle"
                android:layout_width="38dp"
                android:layout_height="22dp"
                android:contentDescription="@string/guard_switch"
                app:lightStyle="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <LinearLayout
                android:id="@+id/row_accessibility"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    style="@style/IconTile"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_accessibility" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/accessibility_service"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Text.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/accessibility_service_sub"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/value_accessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_off"
                    android:textColor="@color/muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/nav_inactive" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/row_divider" />

            <LinearLayout
                android:id="@+id/row_background"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    style="@style/IconTile"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_battery" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/background_stability"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Text.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/background_stability_sub"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/background_stability_value"
                    android:textColor="@color/muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/nav_inactive" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/row_divider" />

            <LinearLayout
                style="@style/SettingsRow"
                android:orientation="horizontal">

                <ImageView
                    style="@style/IconTile"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_scan" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/compatibility_mode"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Text.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/compatibility_mode_sub"
                        android:textSize="9sp" />
                </LinearLayout>

                <com.lightskip.app.ui.ToggleView
                    android:id="@+id/toggle_compat"
                    android:layout_width="38dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/compatibility_mode" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <LinearLayout
                android:id="@+id/row_popup"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    style="@style/IconTile"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_close" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/check_popup"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Text.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/popup_mode_sub"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/value_popup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/popup_off"
                    android:textColor="@color/forest_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/nav_inactive" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/row_divider" />

            <LinearLayout
                android:id="@+id/row_import_rules"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    style="@style/IconTile"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/import_rules_title"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Text.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/import_rules_sub"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/value_import_rules"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/import_rules_value"
                    android:textColor="@color/forest_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/nav_inactive" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/row_divider" />

            <LinearLayout
                android:id="@+id/row_learning"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    style="@style/IconTile"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_scan" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/learning_title"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Text.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/learning_sub"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/value_learning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/learning_off"
                    android:textColor="@color/muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/row_divider" />

            <LinearLayout
                android:id="@+id/row_diagnostics"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    style="@style/IconTile"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/diagnostics_title"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Text.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/diagnostics_sub"
                        android:textSize="9sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/nav_inactive" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <LinearLayout
                android:id="@+id/row_privacy"
                style="@style/SettingsRow"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    style="@style/IconTile"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_privacy" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Text.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_sub"
                        android:textSize="9sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/nav_inactive" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_demo"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:visibility="gone">

            <ImageView
                style="@style/IconTile"
                android:contentDescription="@null"
                android:src="@drawable/ic_scan" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_entry"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Text.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_entry_sub"
                    android:textSize="9sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/nav_inactive" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_demo_popup"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:visibility="gone">

            <ImageView
                style="@style/IconTile"
                android:contentDescription="@null"
                android:src="@drawable/ic_close" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/test_popup"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Text.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/test_popup_sub"
                    android:textSize="9sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/nav_inactive" />
        </LinearLayout>

        <TextView
            android:id="@+id/version_line"
            style="@style/Text.Micro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/version_line_02"
            android:textColor="@color/nav_inactive"
            android:textSize="9sp" />
    </LinearLayout>
</ScrollView>
